# SimpleMediaServer Configuration
# This file contains the configuration for the SimpleMediaServer

# Port to run the server on (optional, default 8080)
# Port = 8080

# Multiple media sources (preferred)
MediaSources = [
    "./testData",
    # Add more paths as needed:
    # "/Users/username/Pictures"
    # "/home/user/Videos"
    # "C:\\Users\\username\\Documents\\Photos"
]

# Single media source (legacy, will be ignored if MediaSources is provided)
# MediaSource = "./testData"

# Example paths:
# MediaSource = "/Users/username/Pictures"
# MediaSource = "/home/user/Videos"
# MediaSource = "C:\\Users\\username\\Documents\\Photos" 

# Registry Configuration (optional)
# These settings control how the service registers with an external registry
# The registry URL is set via the REGISTRY_URL environment variable

# Maximum number of retry attempts for registry registration (default: 10)
# With exponential backoff, this provides ~4 minutes of retry attempts
# RegistryMaxRetries = 10

# Timeout in seconds for each registry HTTP request (default: 10)
# If the registry doesn't respond within this time, the attempt fails and will retry
# RegistryTimeoutSec = 10
